rule agent_prompt_injection_multilingual {
    meta:
        author = "yara-gate"
        description = "Override phrases in Spanish, Portuguese, French, German, Italian, Chinese, Japanese, and Russian"
        intent = "Note on a non-English instruction to ignore or forget the previous instructions"
        severity = "note"
        verdict_on_match = "note"
        reference = "https://genai.owasp.org/llmrisk/llm01-prompt-injection/"
    strings:
        // Non-ASCII letters are written as UTF-8 byte escapes so the source stays ASCII.
        // nocase folds ASCII letters only; accented letters list their own forms.
        $es = /\b(ignora|ignorad|ignore|olvida|olvide)[ \t]+(todas[ \t]+)?(las[ \t]+|tus[ \t]+)?instrucciones[ \t]+(anteriores|previas)\b/ nocase ascii wide
        $pt = /\b(ignore|ignora|esque(c|\xc3\xa7|\xc3\x87)a)[ \t]+(todas[ \t]+)?(as[ \t]+|suas[ \t]+)?instru(\xc3\xa7|\xc3\x87|c)(\xc3\xb5|\xc3\x95|o)es[ \t]+anteriores\b/ nocase ascii wide
        $fr = /\b(ignore|ignorez|oublie|oubliez)[ \t]+(toutes[ \t]+)?(les[ \t]+|tes[ \t]+|vos[ \t]+)?instructions[ \t]+pr(\xc3\xa9|\xc3\x89|e)c(\xc3\xa9|\xc3\x89|e)dentes\b/ nocase ascii wide
        $de = /\b(ignoriere|ignorieren|ignorier|vergiss|vergessen)[ \t]+(sie[ \t]+)?(alle[ \t]+)?(vorherigen|bisherigen|fr(\xc3\xbc|\xc3\x9c|ue)heren|vorangegangenen)[ \t]+(anweisungen|instruktionen)\b/ nocase ascii wide
        $it = /\b(ignora|ignorate|dimentica|dimenticate)[ \t]+(tutte[ \t]+)?(le[ \t]+)?istruzioni[ \t]+precedenti\b/ nocase ascii wide
        // Cyrillic has case; the sentence-initial capital forms are listed.
        $zh = /\xe5\xbf\xbd\xe7\x95\xa5(\xe6\x89\x80\xe6\x9c\x89)?(\xe4\xb9\x8b\xe5\x89\x8d|\xe4\xbb\xa5\xe4\xb8\x8a|\xe5\x85\x88\xe5\x89\x8d|\xe4\xb8\x8a\xe8\xbf\xb0)(\xe7\x9a\x84)?(\xe6\x8c\x87\xe4\xbb\xa4|\xe6\x8c\x87\xe7\xa4\xba|\xe6\x8f\x90\xe7\xa4\xba)/ ascii
        $ja = /(\xe4\xbb\xa5\xe5\x89\x8d|\xe3\x81\x93\xe3\x82\x8c\xe3\x81\xbe\xe3\x81\xa7|\xe4\xb8\x8a\xe8\xa8\x98)\xe3\x81\xae(\xe6\x8c\x87\xe7\xa4\xba|\xe5\x91\xbd\xe4\xbb\xa4)\xe3\x82\x92(\xe3\x81\x99\xe3\x81\xb9\xe3\x81\xa6)?\xe7\x84\xa1\xe8\xa6\x96/ ascii
        $ru = /(\xd0\xb8\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9|\xd0\x98\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9|\xd0\xb8\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9\xd1\x82\xd0\xb5|\xd0\x98\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9\xd1\x82\xd0\xb5|\xd0\xb7\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c|\xd0\x97\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c|\xd0\xb7\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c\xd1\x82\xd0\xb5|\xd0\x97\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c\xd1\x82\xd0\xb5)[ \t]+((\xd0\xb2\xd1\x81\xd0\xb5|\xd0\xb2\xd1\x81\xd1\x91|\xd0\x92\xd1\x81\xd0\xb5|\xd0\x92\xd1\x81\xd1\x91)[ \t]+)?(\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd1\x8b\xd0\xb4\xd1\x83\xd1\x89\xd0\xb8\xd0\xb5|\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd1\x88\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5|\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb6\xd0\xbd\xd0\xb8\xd0\xb5)[ \t]+(\xd0\xb8\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x86\xd0\xb8\xd0\xb8|\xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f)/ ascii
    condition:
        any of them
}
