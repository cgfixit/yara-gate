        $de = /\b(ignoriere|ignorieren|ignorier|vergiss|vergessen)[ \t]+(sie[ \t]+)?((alle|die|deine|ihre)[ \t]+)?(vorherigen|vorigen|bisherigen|fr(\xc3\xbc|\xc3\x9c|ue)heren|vorangegangenen|vorangehenden|vorhergehenden|obigen)[ \t]+(anweisungen|instruktionen|befehle|vorgaben)\b/ nocase ascii wide
        $it = /\b(ignora|ignorate|dimentica|dimenticate)[ \t]+(tutte[ \t]+)?(le[ \t]+)?istruzioni[ \t]+precedenti\b/ nocase ascii wide
        // Cyrillic has case; the sentence-initial capital forms are listed.
        $zh = /(\xe5\xbf\xbd\xe7\x95\xa5|\xe6\x97\xa0\xe8\xa7\x86|\xe7\x84\xa1\xe8\xa6\x96|\xe5\xbf\x98\xe8\xae\xb0|\xe5\xbf\x98\xe8\xa8\x98|\xe5\xbf\x98\xe6\x8e\x89|\xe4\xb8\x8d\xe8\xa6\x81\xe7\x90\x86\xe4\xbc\x9a|\xe4\xb8\x8d\xe8\xa6\x81\xe7\x90\x86\xe6\x9c\x83)(\xe6\x89\x80\xe6\x9c\x89|\xe5\x85\xa8\xe9\x83\xa8|\xe4\xb8\x80\xe5\x88\x87)?(\xe4\xb9\x8b\xe5\x89\x8d|\xe4\xbb\xa5\xe4\xb8\x8a|\xe5\x85\x88\xe5\x89\x8d|\xe4\xb8\x8a\xe8\xbf\xb0|\xe5\x89\x8d\xe9\x9d\xa2|\xe4\xb8\x8a\xe9\x9d\xa2|\xe6\xad\xa4\xe5\x89\x8d|\xe4\xbb\xa5\xe5\x89\x8d)(\xe7\x9a\x84)?(\xe6\x89\x80\xe6\x9c\x89|\xe5\x85\xa8\xe9\x83\xa8|\xe4\xb8\x80\xe5\x88\x87)?(\xe7\x9a\x84)?(\xe6\x8c\x87\xe4\xbb\xa4|\xe6\x8c\x87\xe7\xa4\xba|\xe6\x8f\x90\xe7\xa4\xba|\xe5\x91\xbd\xe4\xbb\xa4|\xe8\xaf\xb4\xe6\x98\x8e|\xe8\xaa\xaa\xe6\x98\x8e)/ ascii
        $ja = /(\xe4\xbb\xa5\xe5\x89\x8d|\xe3\x81\x93\xe3\x82\x8c\xe3\x81\xbe\xe3\x81\xa7|\xe4\xb8\x8a\xe8\xa8\x98|\xe5\x89\x8d|\xe5\x85\x88\xe3\x81\xbb\xe3\x81\xa9|\xe4\xbb\x8a\xe3\x81\xbe\xe3\x81\xa7|\xe5\x89\x8d\xe8\xbf\xb0)\xe3\x81\xae(\xe3\x81\x99\xe3\x81\xb9\xe3\x81\xa6\xe3\x81\xae|\xe5\x85\xa8\xe3\x81\xa6\xe3\x81\xae)?(\xe6\x8c\x87\xe7\xa4\xba|\xe5\x91\xbd\xe4\xbb\xa4|\xe6\x8c\x87\xe4\xbb\xa4|\xe3\x83\x97\xe3\x83\xad\xe3\x83\xb3\xe3\x83\x97\xe3\x83\x88)(\xe3\x82\x92|\xe3\x81\xaf)(\xe3\x81\x99\xe3\x81\xb9\xe3\x81\xa6|\xe5\x85\xa8\xe3\x81\xa6|\xe5\x85\xa8\xe9\x83\xa8)?(\xe7\x84\xa1\xe8\xa6\x96|\xe5\xbf\x98\xe3\x82\x8c|\xe7\xa0\xb4\xe6\xa3\x84)/ ascii
        $ru = /(\xd0\xb8\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9|\xd0\x98\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9|\xd0\xb8\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9\xd1\x82\xd0\xb5|\xd0\x98\xd0\xb3\xd0\xbd\xd0\xbe\xd1\x80\xd0\xb8\xd1\x80\xd1\x83\xd0\xb9\xd1\x82\xd0\xb5|\xd0\xb7\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c|\xd0\x97\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c|\xd0\xb7\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c\xd1\x82\xd0\xb5|\xd0\x97\xd0\xb0\xd0\xb1\xd1\x83\xd0\xb4\xd1\x8c\xd1\x82\xd0\xb5)[ \t]+((\xd0\xb2\xd1\x81\xd0\xb5|\xd0\xb2\xd1\x81\xd1\x91|\xd0\x92\xd1\x81\xd0\xb5|\xd0\x92\xd1\x81\xd1\x91)[ \t]+)?(\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd1\x8b\xd0\xb4\xd1\x83\xd1\x89\xd0\xb8\xd0\xb5|\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb4\xd1\x88\xd0\xb5\xd1\x81\xd1\x82\xd0\xb2\xd1\x83\xd1\x8e\xd1\x89\xd0\xb8\xd0\xb5|\xd0\xbf\xd1\x80\xd0\xb5\xd0\xb6\xd0\xbd\xd0\xb8\xd0\xb5)[ \t]+(\xd0\xb8\xd0\xbd\xd1\x81\xd1\x82\xd1\x80\xd1\x83\xd0\xba\xd1\x86\xd0\xb8\xd0\xb8|\xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbd\xd0\xb8\xd1\x8f)/ ascii
