rule agent_prompt_injection_multilingual {
    meta:
        author = "yara-gate"
        description = "Override phrases in Spanish, Portuguese, French, German, Italian, Dutch, Polish, Turkish, Indonesian, Vietnamese, Chinese, Japanese, Korean, Russian, Arabic, and Hindi"
        intent = "Note on a non-English instruction to ignore or forget the previous instructions"
        severity = "note"
        verdict_on_match = "note"
        reference = "https://genai.owasp.org/llmrisk/llm01-prompt-injection/"
    strings:
        // Non-ASCII letters are written as UTF-8 byte escapes so the source stays ASCII.
        // nocase folds ASCII letters only; accented letters list their own forms.
        $es = /\b(ignora|ignorad|ignore|olvida|olvide)[ \t]+(todas[ \t]+)?(las[ \t]+|tus[ \t]+)?instrucciones[ \t]+(anteriores|previas)\b/ nocase ascii wide
        $pt = /\b(ignore|ignora|esque(c|\xc3\xa7|\xc3\x87)a)[ \t]+(todas[ \t]+)?(as[ \t]+|suas[ \t]+)?instru(\xc3\xa7|\xc3\x87|c)(\xc3\xb5|\xc3\x95|o)es[ \t]+anteriores\b/ nocase ascii wide
