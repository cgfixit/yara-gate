        $hi = /(\xe0\xa4\xb8\xe0\xa4\xad\xe0\xa5\x80[ \t]+)?(\xe0\xa4\xaa\xe0\xa4\xbf\xe0\xa4\x9b\xe0\xa4\xb2\xe0\xa5\x87|\xe0\xa4\xaa\xe0\xa5\x82\xe0\xa4\xb0\xe0\xa5\x8d\xe0\xa4\xb5|\xe0\xa4\x89\xe0\xa4\xaa\xe0\xa4\xb0\xe0\xa5\x8b\xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xa4)[ \t]+(\xe0\xa4\xb8\xe0\xa4\xad\xe0\xa5\x80[ \t]+)?(\xe0\xa4\xa8\xe0\xa4\xbf\xe0\xa4\xb0\xe0\xa5\x8d\xe0\xa4\xa6\xe0\xa5\x87\xe0\xa4\xb6\xe0\xa5\x8b\xe0\xa4\x82|\xe0\xa4\x86\xe0\xa4\xa6\xe0\xa5\x87\xe0\xa4\xb6\xe0\xa5\x8b\xe0\xa4\x82)[ \t]+((\xe0\xa4\x95\xe0\xa5\x8b|\xe0\xa4\x95\xe0\xa5\x80)[ \t]+)?(\xe0\xa4\x85\xe0\xa4\xa8\xe0\xa4\xa6\xe0\xa5\x87\xe0\xa4\x96\xe0\xa4\xbe|\xe0\xa4\xa8(\xe0\xa4\x9c(\xe0\xa4\xbc)?|\xe0\xa5\x9b)\xe0\xa4\xb0\xe0\xa4\x85\xe0\xa4\x82\xe0\xa4\xa6\xe0\xa4\xbe(\xe0\xa4\x9c(\xe0\xa4\xbc)?|\xe0\xa5\x9b)|\xe0\xa4\xad\xe0\xa5\x82\xe0\xa4\xb2|\xe0\xa4\x89\xe0\xa4\xaa\xe0\xa5\x87\xe0\xa4\x95\xe0\xa5\x8d\xe0\xa4\xb7\xe0\xa4\xbe)/ ascii
