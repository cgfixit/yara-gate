        $nl = /\b(negeer|vergeet)[ \t]+(alle[ \t]+)?((de|je|jouw|uw)[ \t]+)?(vorige|voorgaande|eerdere|bovenstaande)[ \t]+(instructies|aanwijzingen|opdrachten)\b/ nocase ascii wide
        $pl = /\b(zignoruj|ignoruj|pomi(n|\xc5\x84))[ \t]+(wszystkie[ \t]+)?(poprzednie|wcze(s|\xc5\x9b)niejsze|powy(z|\xc5\xbc)sze)[ \t]+(instrukcje|polecenia|wytyczne)\b/ nocase ascii wide
        $tr = /(t(u|\xc3\xbc|\xc3\x9c)m[ \t]+)?((o|\xc3\xb6|\xc3\x96)nceki|yukar(i|\xc4\xb1)daki)[ \t]+(t(u|\xc3\xbc|\xc3\x9c)m[ \t]+)?(talimatlar(i|\xc4\xb1)|y(o|\xc3\xb6|\xc3\x96)nergeleri|komutlar(i|\xc4\xb1))[ \t]+(yok[ \t]?say|g(o|\xc3\xb6|\xc3\x96)rmezden[ \t]+gel|unut|dikkate[ \t]+alma)/ nocase ascii wide
        $id = /\b(abaikan|lupakan)[ \t]+(semua[ \t]+|seluruh[ \t]+)?(instruksi|perintah|petunjuk|arahan)[ \t]+(sebelumnya|sebelum[ \t]+ini|di[ \t]+atas)\b/ nocase ascii wide
        $vi = /\bb\xe1\xbb\x8f[ \t]+qua[ \t]+(t\xe1\xba\xa5t[ \t]+c\xe1\xba\xa3[ \t]+)?(c\xc3\xa1c[ \t]+)?(h\xc6\xb0\xe1\xbb\x9bng[ \t]+d\xe1\xba\xabn|ch\xe1\xbb\x89[ \t]+d\xe1\xba\xabn|ch\xe1\xbb\x89[ \t]+th\xe1\xbb\x8b|l\xe1\xbb\x87nh)[ \t]+(tr\xc6\xb0\xe1\xbb\x9bc([ \t]+\xc4\x91\xc3\xb3)?|\xe1\xbb\x9f[ \t]+tr\xc3\xaan|ph\xc3\xada[ \t]+tr\xc3\xaan|b\xc3\xaan[ \t]+tr\xc3\xaan)/ nocase ascii wide
        // Korean, Arabic (with and without hamza on the alef), and Hindi (the nukta composed,
        // decomposed, or left out). These scripts have no letter case.
        $ko = /(\xec\x9d\xb4\xec\xa0\x84|\xec\x9c\x84|\xec\x95\x9e|\xea\xb8\xb0\xec\xa1\xb4|\xec\xa7\x80\xea\xb8\x88\xea\xb9\x8c\xec\xa7\x80)(\xec\x9d\x98)?[ \t]?(\xeb\xaa\xa8\xeb\x93\xa0[ \t])?(\xec\xa7\x80\xec\x8b\x9c\xec\x82\xac\xed\x95\xad|\xec\xa7\x80\xec\x8b\x9c|\xec\xa7\x80\xec\xb9\xa8|\xeb\xaa\x85\xeb\xa0\xb9\xec\x96\xb4|\xeb\xaa\x85\xeb\xa0\xb9|\xed\x94\x84\xeb\xa1\xac\xed\x94\x84\xed\x8a\xb8)(\xeb\x93\xa4\xec\x9d\x84|\xeb\x93\xa4\xec\x9d\x80|\xec\x9d\x84|\xeb\xa5\xbc|\xec\x9d\x80|\xeb\x8a\x94)?[ \t]?((\xeb\xaa\xa8\xeb\x91\x90|\xec\xa0\x84\xeb\xb6\x80|\xeb\x8b\xa4)[ \t])?(\xeb\xac\xb4\xec\x8b\x9c|\xec\x9e\x8a\xec\x96\xb4|\xec\x9e\x8a\xec\x9c\xbc)/ ascii
